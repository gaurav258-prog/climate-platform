.env
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/
data/storage/
*.tif
*.nc
*.grib2
mlflow.db

# fetched climate data (large, reproducible via scripts/fetch_era5_baseline.py)
data/era5_baseline/
data/era5_climatology_baseline/
data/era5_soil_moisture_baseline/
data/era5_frost_baseline/

# local tooling state, not project source
.claude-flow/
data/faostat/
data/usda_psd/
data/worldbank/

# MITECO reservoir raw dumps — large; keep only the compact distilled index in git
data/reservoirs/*.mdb
data/reservoirs/*.zip
data/reservoirs/embalses.csv
data/reservoirs/embalses_iso.csv

# Hansen forest tiles (large, reproducible via scripts/ingest_forest_baseline.py)
data/forest/

# Large geospatial source files (preprocessed into protected_h3_cell)
data/natura2000/
data/wdpa/
data/wdoecm/
data/kba/

# EU-Taxonomy hazard source rasters/tables (large, reproducible via scripts/fetch_*.py / ingest_*.py)
data/subsidence/
data/permafrost/
data/soil_erosion/
data/coastal_erosion/
data/glacial_lakes/
data/ocean_ph/*
!data/ocean_ph/ocean_ph_grid.npz
data/soil_degradation/
data/convective/*
!data/convective/convective_potential.npz
data/eiopa/
data/reference/geo/

# independent backtest targets (re-fetched by scripts/fetch_*.py; see docs/BACKTEST_DATA.md)
data/coastal_val/
data/wildfire_val/
data/flood_val/

# wildfire climatology per-year caches (rebuilt by scripts/build_*_climatology.py); the two final *_climatology.npz are tracked
data/wildfire/ba_*.npz
data/wildfire/fwi_*.npz
data/wildfire/burnable_fraction.npz
!data/wildfire/fwi_climatology.npz
!data/wildfire/burned_area_climatology.npz
!data/reference/geo/
data/reference/geo/*
!data/reference/geo/nuts3_eu_20m_2021.geojson

# the one land layer every map cell is clipped against (services/geo/cells.py)
!data/reference/geo/countries_world_03m_2020.geojson.gz
data/ghcn/
data/tide_gauges/
data/subsidence_val/
data/jrc_flood/
