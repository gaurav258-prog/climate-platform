{
  "_about": "Supervision profiles — what a regulator/supervisor customer supervises and how the platform serves it. CONFIGURATION, not code: a new sector supervisor is a new profile entry (or a per-org override in supervisor_settings), never a code path that names a sector. Loaded by services/supervision/profiles.py. Metric ids resolve to sector adapters registered in services/supervision/metrics.py; region units to services/geo/regions.py; framework ids to services/governance/filings.",
  "version": "1.0",
  "roles": {
    "_about": "Role templates seeded for every regulator organization (RBAC roles are DB rows; these are the defaults). Permission codes are the supervisor.* family plus platform basics.",
    "supervisor": {
      "label": "Line supervisor",
      "stages": [
        "analyse",
        "engage",
        "follow_up"
      ],
      "permissions": [
        "modules.view",
        "supervisor.population.view",
        "supervisor.entity.view",
        "supervisor.entity.file",
        "supervisor.sites.view",
        "supervisor.requests.manage",
        "supervisor.findings.manage"
      ]
    },
    "risk_analyst": {
      "label": "Horizontal risk analyst",
      "stages": [
        "analyse",
        "challenge",
        "report"
      ],
      "permissions": [
