{
  "_about": "Supervision profiles: what a regulator or supervisor customer supervises and how the platform serves it. A new sector supervisor is a new profile entry; per-organisation overrides are stored in the regulator's settings.",
  "version": "1.0",
  "roles": {
    "_about": "Default role templates seeded for every regulator organisation. 'scope' says what a user with this role sees: 'assigned' = only the entities assigned to them (their case list); 'population' = every entity the organisation supervises. A user with several roles gets the widest scope among them.",
    "supervisor": {
      "label": "Line supervisor",
      "scope": "assigned",
      "stages": [
        "analyse",
        "engage",
        "follow_up"
      ],
      "permissions": [
        "modules.view",
        "supervisor.population.view",
        "supervisor.entity.view",
        "supervisor.entity.file",
        "supervisor.sites.view",
        "supervisor.requests.manage",
        "supervisor.findings.manage"
      ]
    },
    "risk_analyst": {
      "label": "Horizontal risk analyst",
      "scope": "population",
      "stages": [
        "analyse",
        "challenge",
        "report"
      ],
      "permissions": [
        "modules.view",
        "supervisor.population.view",
        "supervisor.benchmark.view",
        "supervisor.entity.view",
        "supervisor.entity.file",
        "supervisor.export"
      ]
    },
    "data_steward": {
      "label": "Data & reporting",
