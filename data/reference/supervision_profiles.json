  "sectors": {
    "_about": "Per supervised sector: the frameworks the supervisor expects, the regional unit it works in, and the benchmark metrics used for peer comparison. exposure_measure = the sector's exposure basis for the Tier-1 plausibility band: cell_field is the canonical template column the band divides by and weights with, label is the sector's own word for it, prior is the reference the band is judged against (scored_land: every scored land cell, equal weight; population_exposure: this authority's supervised population of the sector, weighted by the measure, the entity under review excluded). Thresholds are supervisory-expectation defaults, overridable per regulator.",
    "bank": {
      "label": "Credit institutions",
      "authorities_example": [
        "ECB/SSM",
        "national competent authority"
      ],
      "frameworks": [
        "pillar3_esg",
        "eba_climate_stress",
        "csrd_esrs"
      ],
      "region_unit": "nuts3",
      "book_noun": "financed assets",
      "exposure_measure": {
        "cell_field": "gross_carrying_amount_eur",
        "label": "Gross carrying amount",
        "prior": "scored_land",
        "_why": "Pillar 3 Template 5 reports exposure by counterparty geography across every sector, so the reference is the geography itself: every scored land cell, equal weight."
      },
      "metrics": [
        {
          "id": "book_value_eur",
          "label": "Book value",
          "unit": "eur",
          "adapter": "portfolio.book_value",
          "direction": "neutral"
        },
        {
          "id": "high_risk_share_pct",
          "label": "Share of book at high risk",
          "unit": "pct",
          "adapter": "portfolio.high_risk_share",
          "direction": "lower_is_better",
          "watch_above": 25,
          "act_above": 40
        },
        {
          "id": "money_at_high_risk_eur",
          "label": "Money at high risk",
          "unit": "eur",
          "adapter": "portfolio.high_risk_value",
          "direction": "lower_is_better"
        },
        {
          "id": "top_hazard_concentration_pct",
          "label": "Concentration in worst hazard",
          "unit": "pct",
          "adapter": "portfolio.top_hazard_share",
          "direction": "lower_is_better",
          "watch_above": 50
        },
        {
          "id": "top_region_concentration_pct",
          "label": "Concentration in worst region",
          "unit": "pct",
          "adapter": "portfolio.top_region_share",
          "direction": "lower_is_better",
          "watch_above": 35
        },
        {
          "id": "scored_coverage_pct",
          "label": "Assets with a score",
          "unit": "pct",
          "adapter": "portfolio.scored_share",
          "direction": "higher_is_better",
          "watch_below": 90
        }
      ],
      "intake": {
        "_about": "Tier-2 intake for a banking supervisor: the submitted template and the supervisor's own granular data. Map your file's columns to the fields below; the mapping is validated before saving.",
        "submission": {
          "framework": "pillar3_esg",
          "template": "template_5",
          "label": "Pillar 3 ESG Template 5 — exposures subject to physical risk by geography",
          "cell_fields": [
            {
              "id": "geography",
              "label": "Geography (country / region)",
              "required": true
            },
            {
              "id": "sector",
              "label": "Sector (NACE section or bucket)",
              "required": true
            },
            {
              "id": "gross_carrying_amount_eur",
              "label": "Gross carrying amount (€)",
              "required": true,
              "type": "number"
            },
            {
              "id": "sensitive_physical_eur",
              "label": "of which sensitive to physical risk (€)",
              "required": true,
              "type": "number"
            },
            {
              "id": "sensitive_acute_eur",
              "label": "of which acute events (€)",
              "required": false,
              "type": "number"
            },
            {
              "id": "sensitive_chronic_eur",
              "label": "of which chronic (€)",
              "required": false,
              "type": "number"
            },
            {
              "id": "maturity_bucket",
              "label": "Maturity bucket",
              "required": false
            }
          ],
          "basis_fields": [
            {
              "id": "scenario",
              "label": "Scenario stated in the narrative"
            },
            {
              "id": "horizon",
              "label": "Horizon stated in the narrative"
            },
            {
              "id": "method_note",
              "label": "Method note (from the qualitative disclosure)"
            }
          ],
          "sector_key": "nace_section"
        },
        "granular": {
          "source": "anacredit",
          "label": "AnaCredit loan-level extract (collateral region)",
          "row_fields": [
            {
              "id": "instrument_id",
              "label": "Instrument id",
              "required": true
            },
            {
              "id": "counterparty_name",
              "label": "Counterparty / debtor name",
              "required": false
            },
            {
              "id": "nace_section",
              "label": "Counterparty sector (NACE)",
              "required": true
            },
            {
              "id": "outstanding_eur",
              "label": "Outstanding nominal amount (€)",
              "required": true,
              "type": "number"
            },
            {
              "id": "maturity_date",
              "label": "Maturity date",
              "required": false,
              "type": "date"
            },
            {
              "id": "collateral_country",
              "label": "Collateral country (ISO2)",
              "required": true
            },
            {
              "id": "collateral_nuts3",
              "label": "Collateral NUTS-3 code",
              "required": false
            },
            {
              "id": "collateral_postcode",
              "label": "Collateral postcode",
              "required": false
            },
            {
              "id": "collateral_value_eur",
              "label": "Collateral / protection value (€)",
              "required": false,
              "type": "number"
            }
          ],
          "location_rule": "Locations are resolved from the NUTS-3 code where available; otherwise the postcode is mapped to NUTS-3 via the Eurostat TERCET correspondence. Rows with a country only remain unlocated and are reported as such.",
          "precision_label": "Region-resolved (NUTS-3)",
          "shadow": {
            "vertical": "banking",
            "entity_type": "loan",
            "asset_class": "buildings"
          }
        }
      }
    },
