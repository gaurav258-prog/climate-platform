        {"id": "high_risk_share_pct",  "label": "Share of book at high risk", "unit": "pct",  "adapter": "portfolio.high_risk_share",  "direction": "lower_is_better", "watch_above": 25, "act_above": 40},
        {"id": "money_at_high_risk_eur","label": "Money at high risk",        "unit": "eur",  "adapter": "portfolio.high_risk_value",  "direction": "lower_is_better"},
        {"id": "top_hazard_concentration_pct", "label": "Concentration in worst hazard", "unit": "pct", "adapter": "portfolio.top_hazard_share", "direction": "lower_is_better", "watch_above": 50},
        {"id": "top_region_concentration_pct", "label": "Concentration in worst region", "unit": "pct", "adapter": "portfolio.top_region_share", "direction": "lower_is_better", "watch_above": 35},
        {"id": "scored_coverage_pct",  "label": "Assets with a score",        "unit": "pct",  "adapter": "portfolio.scored_share",     "direction": "higher_is_better", "watch_below": 90}
