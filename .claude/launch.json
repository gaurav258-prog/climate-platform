{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "investor-brief",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "7891", "--directory", "docs"],
      "port": 7891
    },
    {
      "name": "climate-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ui", "run", "dev"],
      "port": 5173
    },
    {
      "name": "climate-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--port", "8001"],
      "port": 8001
    }
  ]
}
